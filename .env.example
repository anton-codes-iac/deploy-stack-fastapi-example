# ==========================================
# Local Development Environment Variables
# ==========================================
# Copy this file to .env and replace the values

# If you use deploy-stack, these database variables are automatically 
# injected into your AWS Fargate container at runtime. You only need 
# to configure them here for local development.

DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=local_password
DB_NAME=deploy-stack-fastapi-example_db
DB_PORT=5432
# Add your custom API keys and secrets below:
# API_SECRET_KEY=your_super_secret_key